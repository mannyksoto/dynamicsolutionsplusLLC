# Copy to .streamlit/secrets.toml for local testing (it's gitignored).
# On Streamlit Community Cloud, paste this into App settings → Secrets instead.
# For Gmail, use an App Password (Google Account → Security → App passwords), not the real password.

[email]
smtp_server = "smtp.gmail.com"
smtp_port = 587
sender = "yourbusiness@gmail.com"
password = "xxxx xxxx xxxx xxxx"
recipient = "owner@example.com"
